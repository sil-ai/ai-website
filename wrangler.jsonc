// Cloudflare Workers (static assets) config for ai.sil.org.
// Serves the Docusaurus build folder; there is no server code.
{
  "name": "ai-sil-org",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
